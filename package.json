{
	"name": "fise",
	"version": "1.1.0",
	"description": "Fast Interoperable Structured Envelope (FISE) - a versioned, profile-governed application-layer envelope for string and binary payloads.",
	"type": "module",
	"sideEffects": false,
	"bin": {
		"fise": "dist/cli.js"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./conformance": {
			"types": "./dist/conformance.d.ts",
			"import": "./dist/conformance.js"
		},
		"./profiles": {
			"types": "./dist/profiles.d.ts",
			"import": "./dist/profiles.js"
		},
		"./http": {
			"types": "./dist/http.d.ts",
			"import": "./dist/http.js"
		}
	},
	"files": [
		"dist",
		"docs/*.md",
		"reference/python/*.py",
		"reference/python/fixtures/*.json",
		"reference/python/README.md",
		"CHANGELOG.md",
		"CONTRIBUTING.md"
	],
	"scripts": {
		"clean": "node scripts/clean-dist.mjs",
		"build": "npm run clean && tsc -p tsconfig.json && node scripts/mark-cli-executable.mjs",
		"test": "npm run build && node --test tests/*.mjs",
		"verify:types": "tsc --noEmit --strict --target ES2020 --module ESNext --moduleResolution bundler --lib ES2020,DOM --types node --skipLibCheck tests/types/public-api.ts",
		"verify:docs": "node scripts/verify-docs.mjs",
		"verify:interop": "python3 -m unittest discover -s reference/python -p 'test_*.py'",
		"verify:package": "npm run build && npm run verify:docs && npm run verify:types && node scripts/verify-package.mjs",
		"verify:packed": "npm run build && node scripts/verify-packed-package.mjs",
		"verify:browser:serve": "npm run build && node scripts/serve-packed-browser-smoke.mjs",
		"release:check": "npm test && npm run verify:interop && npm run verify:package && npm run verify:packed",
		"prepublishOnly": "npm run release:check",
		"benchmark": "tsx benchmarks/benchmark.ts",
		"benchmark:wasm": "tsx benchmarks/wasm.ts",
		"benchmark:adaptation": "tsx benchmarks/adaptation.ts"
	},
	"keywords": [
		"frontend",
		"api",
		"obfuscation",
		"data-envelope",
		"binary",
		"profile-manifest",
		"web",
		"typescript",
		"webassembly",
		"wasm"
	],
	"author": "An Nguyen",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anbkit/fise.git"
	},
	"bugs": {
		"url": "https://github.com/anbkit/fise/issues"
	},
	"homepage": "https://github.com/anbkit/fise#readme",
	"devDependencies": {
		"@types/node": "^24.10.1",
		"tsx": "^4.20.6",
		"typescript": "^5.6.0"
	}
}
