{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/index.ts",
    "src/profileRuntime.ts",
    "src/cli.ts",
    "src/errors.ts",
    "src/v2/**/*"
  ],
  "exclude": [
    "benchmarks/**/*"
  ]
}
